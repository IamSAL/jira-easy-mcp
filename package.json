{
  "name": "jira-easy-mcp",
  "version": "2.0.0",
  "description": "MCP server for Jira with Basic Auth - works with username/password, no API tokens required",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jira-easy-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run build",
    "start": "npx @modelcontextprotocol/inspector node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "tsc && vitest run && node scripts/run-tests.mjs unit",
    "test:watch": "vitest",
    "reload-mcp": "pnpm run prepublishOnly && node dist/index.js",
    "prepare": "npm run build",
    "test:integration": "tsc && node scripts/run-tests.mjs integration",
    "jira:up": "node test/integration/jira-docker.mjs up",
    "jira:down": "node test/integration/jira-docker.mjs down"
  },
  "keywords": [
    "mcp",
    "jira",
    "atlassian",
    "rest-api",
    "model-context-protocol",
    "claude",
    "ai"
  ],
  "author": "IamSAL",
  "license": "ISC",
  "homepage": "https://github.com/IamSAL/jira-easy-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamSAL/jira-easy-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/IamSAL/jira-easy-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "mime-types": "^3.0.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0",
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "keytar"
    ]
  }
}
